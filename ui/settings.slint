import { ScrollView } from "std-widgets.slint";
import { Theme } from "style.slint";
import { Icon, Button, ButtonKind, TextField, Toggle, Card, Divider, PageBody, PageColumn, PageHeader } from "kit.slint";
import { IconSet } from "@lucide";

component SwitchRow {
    in property <string> label;
    in property <string> hint;
    in property <bool> checked: false;
    callback toggled(bool);

    HorizontalLayout {
        spacing: Theme.space-4;
        alignment: start;
        padding-top: Theme.space-1;
        padding-bottom: Theme.space-1;

        VerticalLayout {
            spacing: 1px;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                font-size: Theme.text-body;
                color: Theme.text;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            if root.hint != "" : Text {
                text: root.hint;
                font-size: Theme.text-caption;
                color: Theme.text-3;
                wrap: word-wrap;
            }
        }

        Toggle {
            checked: root.checked;
            toggled(v) => { root.toggled(v); }
        }
    }
}

export component SettingsView inherits Rectangle {
    background: Theme.bg-gradient;

    in-out property <bool> jd-enabled: true;
    in-out property <string> jd-city: "WARSZAWA";

    in-out property <string> jd-start-name: "Plac Defilad 1";
    in-out property <string> jd-start-type: "ADDRESS";
    in-out property <string> jd-start-lat: "52.2319";
    in-out property <string> jd-start-lon: "21.0067";
    in-out property <string> jd-start-code: "";

    in-out property <string> jd-dest-name: "Międzynarodowa";
    in-out property <string> jd-dest-type: "STOP_POINT";
    in-out property <string> jd-dest-lat: "52.2299";
    in-out property <string> jd-dest-lon: "21.0687";
    in-out property <string> jd-dest-code: "209802";

    in-out property <string> jd-buffer: "5";
    in-out property <string> jd-avoid-lines: "";
    in-out property <bool> jd-avoid-changes: false;
    in-out property <bool> jd-prefer-metro: false;
    in-out property <string> jd-preferred-lines: "";
    in-out property <string> save-status: "";
    in-out property <bool> show-advanced: false;

    callback save-settings();

    ScrollView {
        PageBody {
            PageColumn {
            width-px: 760px;

            PageHeader {
                title: "Ustawienia";
                subtitle: "Dojazd do szkoły i preferencje";
            }

            // ── Commute ──────────────────────────────────────────────────────
            Card {
                VerticalLayout {
                    padding: Theme.space-4;
                    spacing: Theme.space-4;

                    HorizontalLayout {
                        spacing: Theme.space-3;
                        alignment: start;

                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.radius-lg;
                            background: Theme.accent-soft;
                            Icon {
                                icon: IconSet.Bus;
                                size: 16px;
                                tint: Theme.accent-text;
                                weight: 1.75;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                        VerticalLayout {
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Dojazd do szkoły";
                                font-size: Theme.text-title;
                                font-weight: 600;
                                color: Theme.text;
                            }
                            Text {
                                text: "Jakdojade wylicza, o której musisz wyjść na pierwszą lekcję.";
                                font-size: Theme.text-caption;
                                color: Theme.text-3;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Divider {}

                    SwitchRow {
                        label: "Widżet na panelu bocznym";
                        hint: "Pokazuje najbliższe połączenie w menu.";
                        checked: root.jd-enabled;
                        toggled(v) => { root.jd-enabled = v; }
                    }

                    Divider {}

                    HorizontalLayout {
                        spacing: Theme.space-4;
                        // No `alignment: start` here: that pins every child to its
                        // minimum preferred width and ignores horizontal-stretch,
                        // which collapsed the "Miasto" field down to "Wa".

                        VerticalLayout {
                            horizontal-stretch: 2;
                            TextField {
                                label: "Miasto";
                                placeholder: "np. Warszawa";
                                text <=> root.jd-city;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField {
                                label: "Zapas (min)";
                                placeholder: "5";
                                text <=> root.jd-buffer;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;
                        TextField {
                            label: "Skąd wyjeżdżasz";
                            placeholder: "ul. Marszałkowska 10 lub nazwa przystanku";
                            text <=> root.jd-start-name;
                        }
                        Text {
                            text: "Adres domowy albo nazwa przystanku początkowego.";
                            font-size: Theme.text-caption;
                            color: Theme.text-4;
                        }
                    }

                    VerticalLayout {
                        spacing: Theme.space-2;
                        TextField {
                            label: "Dokąd jedziesz";
                            placeholder: "adres szkoły lub nazwa przystanku";
                            text <=> root.jd-dest-name;
                        }
                        Text {
                            text: "Adres szkoły albo najbliższy przystanek docelowy.";
                            font-size: Theme.text-caption;
                            color: Theme.text-4;
                        }
                    }

                    Divider {}

                    SwitchRow {
                        label: "Preferuj metro";
                        hint: "Trasa w pierwszej kolejności korzysta z M1 / M2.";
                        checked: root.jd-prefer-metro;
                        toggled(v) => { root.jd-prefer-metro = v; }
                    }

                    SwitchRow {
                        label: "Unikaj przesiadek";
                        hint: "Preferuje połączenia bezpośrednie, nawet jeśli są dłuższe.";
                        checked: root.jd-avoid-changes;
                        toggled(v) => { root.jd-avoid-changes = v; }
                    }

                    Divider {}

                    TextField {
                        label: "Preferowane linie";
                        placeholder: "np. M1, 509, 17";
                        text <=> root.jd-preferred-lines;
                    }

                    TextField {
                        label: "Linie do unikania";
                        placeholder: "np. 516, L-1, N42";
                        text <=> root.jd-avoid-lines;
                    }

                    Divider {}

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;

                        Text {
                            text: root.save-status;
                            font-size: Theme.text-caption;
                            font-weight: 600;
                            color: Theme.success;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        Button {
                            label: root.show-advanced ? "Ukryj zaawansowane" : "Zaawansowane";
                            kind: ButtonKind.ghost;
                            clicked => { root.show-advanced = !root.show-advanced; }
                        }
                        Button {
                            label: "Zapisz";
                            kind: ButtonKind.primary;
                            with-icon: true;
                            icon: IconSet.Check;
                            clicked => { root.save-settings(); }
                        }
                    }
                }
            }

            // ── Advanced ─────────────────────────────────────────────────────
            if root.show-advanced : Card {
                VerticalLayout {
                    padding: Theme.space-4;
                    spacing: Theme.space-4;

                    HorizontalLayout {
                        spacing: Theme.space-2;
                        alignment: start;
                        Icon {
                            icon: IconSet.TriangleAlert;
                            size: 14px;
                            tint: Theme.warning;
                            weight: 1.75;
                            y: 1px;
                        }
                        Text {
                            text: "Współrzędne są uzupełniane automatycznie z podanych adresów. Koryguj tylko wtedy, gdy trasa wypada błędnie.";
                            font-size: Theme.text-caption;
                            color: Theme.text-3;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    Divider {}

                    Text {
                        text: "Punkt początkowy";
                        font-size: Theme.text-caption;
                        font-weight: 600;
                        color: Theme.text-3;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-3;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Typ"; text <=> root.jd-start-type; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Szerokość"; text <=> root.jd-start-lat; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Długość"; text <=> root.jd-start-lon; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Kod"; text <=> root.jd-start-code; }
                        }
                    }

                    Text {
                        text: "Punkt docelowy";
                        font-size: Theme.text-caption;
                        font-weight: 600;
                        color: Theme.text-3;
                    }
                    HorizontalLayout {
                        spacing: Theme.space-3;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Typ"; text <=> root.jd-dest-type; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Szerokość"; text <=> root.jd-dest-lat; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Długość"; text <=> root.jd-dest-lon; }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            TextField { label: "Kod"; text <=> root.jd-dest-code; }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
            }
        }
    }
}
