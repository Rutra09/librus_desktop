import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";
import { Theme } from "style.slint";
import { Sidebar } from "sidebar.slint";
import { LoginView } from "login.slint";
import { DashboardView, DashboardGrade, DashboardHomework, DashboardAnnouncement, DashboardLesson } from "dashboard.slint";
import { TimetableView, UIGridRow, UIGridCell } from "timetable.slint";
import { GradesView, UISubjectGrades, UIGrade } from "grades.slint";
import { AnnouncementsView, UIAnnouncement } from "announcements.slint";
import { AttendanceView, UIAttendance, UIAttendanceSubject } from "attendance.slint";

import { MessagesView, UIMessage } from "messages.slint";
import { HomeworkView, UIHomework } from "homework.slint";
import { EventsView, UIEvent } from "events.slint";
import { SettingsView } from "settings.slint";

export component MainWindow inherits Window {
    title: "Librus Desktop";
    icon: @image-url("../icon.png");
    // width: 1200px;
    // height: 800px;
    
    background: Theme.background;

    in-out property <int> active-page: 0; // 0: Login, 1: Dashboard, 2: Timetable, 3: Grades, 4: Announcements, 5: Attendance, 6: Messages, 7: Homework, 8: Events, 9: Settings
    in-out property <string> login-error;
    in-out property <bool> is-logging-in: false;
    in-out property <bool> has-synergia-credentials: false;
    
    // Data properties for various views
    in-out property <string> user-name: "...";
    in-out property <string> lucky-number: "";
    in-out property <string> lucky-number-for: "";
    in-out property <string> lucky-number-day: "";

    // Jakdojade properties
    in-out property <bool> jd-enabled: true;
    in-out property <string> jd-leave-time: "";
    in-out property <string> jd-arrival-info: "";
    in-out property <string> jd-lesson-day: "";
    in-out property <string> jd-route-lines: "";
    in-out property <string> jd-route-summary: "";
    in-out property <string> jd-status: "";
    in-out property <string> jd-city: "WARSZAWA";
    in-out property <string> jd-start-name: "Plac Defilad 1";
    in-out property <string> jd-start-type: "ADDRESS";
    in-out property <string> jd-start-lat: "52.2319";
    in-out property <string> jd-start-lon: "21.0067";
    in-out property <string> jd-start-code: "";
    in-out property <string> jd-dest-name: "Międzynarodowa";
    in-out property <string> jd-dest-type: "STOP_POINT";
    in-out property <string> jd-dest-lat: "52.2299";
    in-out property <string> jd-dest-lon: "21.0687";
    in-out property <string> jd-dest-code: "209802";
    in-out property <string> jd-buffer: "5";
    in-out property <string> jd-avoid-lines: "";
    in-out property <bool> jd-avoid-changes: false;
    in-out property <bool> jd-prefer-metro: false;
    in-out property <string> jd-preferred-lines: "";
    in-out property <string> jd-save-status: "";

    callback save-jakdojade-settings(bool, string, string, string, string, string, string, string, string, string, string, string, string, string, bool, bool, string);



    // Dashboard widgets properties
    in-out property <[DashboardGrade]> dashboard-recent-grades;
    in-out property <[DashboardHomework]> dashboard-upcoming-homework;
    in-out property <[DashboardAnnouncement]> dashboard-recent-announcements;
    in-out property <[DashboardLesson]> dashboard-next-day-timetable;
    in-out property <string> dashboard-next-day-timetable-date;

    // Timetable properties
    in-out property <[UIGridRow]> timetable-grid-rows;
    in-out property <[string]> timetable-day-headers;
    in-out property <string> timetable-week-range: "Loading...";
    in-out property <int> timetable-today-col: -1;

    // Grades properties
    in-out property <[UISubjectGrades]> grades-list;
    
    // Announcements properties
    in-out property <[UIAnnouncement]> announcements-list;

    callback request-login(string, string);
    callback request-logout();
    callback request-refresh();
    callback request-timetable();
    callback request-grades();
    callback request-announcements();
    callback request-prev-week();
    callback request-next-week();

    // Attendance properties
    in-out property <[UIAttendance]> attendances_list;
    in-out property <[UIAttendanceSubject]> attendance_stats;
    in-out property <string> attendance_frequency;
    callback request-attendances();

    // Messages properties
    in-out property <[UIMessage]> messages-list;
    in-out property <string> selected-message-body: "";
    in-out property <bool> showing-details: false;
    callback request-messages();
    callback request-message-details(int);
    
    // Homework properties
    in-out property <[UIHomework]> homework-list;
    callback request-homework();

    // Events properties
    in-out property <[UIEvent]> events-upcoming;
    in-out property <[UIEvent]> events-today;
    in-out property <[UIEvent]> events-past;
    
    // Synergia credentials dialog
    in-out property <bool> show-synergia-dialog: false;
    callback submit-synergia-credentials(string, string);
    callback skip-synergia-credentials();
    
    // Auto-Updater properties
    in-out property <bool> show-update-dialog: false;
    in-out property <string> update-version: "";
    in-out property <bool> is-updating: false;
    in-out property <string> update-status: "Nowa wersja jest gotowa do pobrania i instalacji.";
    callback request-install-update();
    callback close-update-dialog();
    
    preferred-width: 1600px;
    preferred-height: 1000px;

    callback add-simulated-grade(int, string, float);

    HorizontalBox {
        padding: 0px;
        spacing: 0px;

        if active-page != 0 : Sidebar {
            active-page: active-page;
            user-name: user-name;
            lucky-number: lucky-number;
            jd-enabled: jd-enabled;
            jd-leave-time: jd-leave-time;
            jd-arrival-info: jd-arrival-info;
            jd-lesson-day: jd-lesson-day;
            jd-route-lines: jd-route-lines;
            jd-route-summary: jd-route-summary;
            jd-status: jd-status;
            navigate(p) => {
                active-page = p;
            }
            logout => { request-logout(); }
            refresh => { request-refresh(); }
        }


        Rectangle {
            background: Theme.background;
            clip: true;

            LoginView {
                visible: active-page == 0;
                error-message: login-error;
                is-loading: is-logging-in;
                login(email, password) => {
                     request-login(email, password);
                }
            }

            DashboardView {
                visible: active-page == 1;
                user-name: user-name;
                lucky-number: lucky-number;
                lucky-number-day: lucky-number-day;
                recent-grades: root.dashboard-recent-grades;
                upcoming-homework: root.dashboard-upcoming-homework;
                recent-announcements: root.dashboard-recent-announcements;
                next-day-timetable: root.dashboard-next-day-timetable;
                next-day-timetable-date: root.dashboard-next-day-timetable-date;
            }

            TimetableView {
                visible: active-page == 2;
                grid-rows: timetable-grid-rows;
                day-headers: timetable-day-headers;
                week-range: timetable-week-range;
                today-col-index: timetable-today-col;
                prev-week => { request-prev-week(); }
                next-week => { request-next-week(); }
            }
            
            GradesView {
                visible: active-page == 3;
                subjects: grades-list;
                back => { active-page = 1; }
                add-simulated-grade(idx, val, weight) => { 
                    root.add-simulated-grade(idx, val, weight); 
                }
            }
            
            AnnouncementsView {
                visible: active-page == 4;
                notices: announcements-list;
                back => { active-page = 1; }
            }
            
            AttendanceView {
                visible: active-page == 5;
                attendances: attendances_list;
                frequency-str: attendance-frequency;
                stats: attendance_stats;
            }
            
            MessagesView {
                visible: active-page == 6;
                messages: messages-list;
                needs-credentials: !has-synergia-credentials;
                selected-message-body: selected-message-body;
                showing-details: showing-details;
                submit-credentials(username, password) => {
                    root.submit-synergia-credentials(username, password);
                }
                request-message-details(id) => {
                    root.request-message-details(id);
                }
                close-details() => {
                    root.showing-details = false;
                }
                back => { active-page = 1; }
            }
            
            HomeworkView {
                visible: active-page == 7;
                homework-list: homework-list;
                back => { active-page = 1; }
            }
            
            EventsView {
                visible: active-page == 8;
                upcoming-events: events-upcoming;
                today-events: events-today;
                past-events: events-past;
            }

            SettingsView {
                visible: active-page == 9;
                jd-enabled: jd-enabled;
                jd-city: jd-city;
                jd-start-name: jd-start-name;
                jd-start-type: jd-start-type;
                jd-start-lat: jd-start-lat;
                jd-start-lon: jd-start-lon;
                jd-start-code: jd-start-code;
                jd-dest-name: jd-dest-name;
                jd-dest-type: jd-dest-type;
                jd-dest-lat: jd-dest-lat;
                jd-dest-lon: jd-dest-lon;
                jd-dest-code: jd-dest-code;
                jd-buffer: jd-buffer;
                jd-avoid-lines: jd-avoid-lines;
                jd-avoid-changes: jd-avoid-changes;
                jd-prefer-metro: jd-prefer-metro;
                jd-preferred-lines: jd-preferred-lines;
                save-status: jd-save-status;
                save-settings => {
                    root.save-jakdojade-settings(
                        self.jd-enabled,
                        self.jd-city,
                        self.jd-start-name,
                        self.jd-start-type,
                        self.jd-start-lat,
                        self.jd-start-lon,
                        self.jd-start-code,
                        self.jd-dest-name,
                        self.jd-dest-type,
                        self.jd-dest-lat,
                        self.jd-dest-lon,
                        self.jd-dest-code,
                        self.jd-buffer,
                        self.jd-avoid-lines,
                        self.jd-avoid-changes,
                        self.jd-prefer-metro,
                        self.jd-preferred-lines
                    );
                }
            }



            
            // Update Dialog Overlay
            if root.show-update-dialog : Rectangle {
                width: 100%; height: 100%;
                TouchArea {} // Block clicks to background
                Rectangle {
                    background: #00000080;
                }
                Rectangle {
                    width: 380px; height: 180px;
                    background: Theme.card;
                    border-radius: Theme.radius;
                    border-width: 1px;
                    border-color: Theme.border;

                    VerticalBox {
                        padding: 24px;
                        spacing: 16px;
                        alignment: center;
                        Text { text: "Dostępna Aktualizacja"; font-size: 20px; font-weight: 700; color: Theme.foreground; }
                        Text { text: root.update-status + " (" + root.update-version + ")"; font-size: 14px; color: Theme.muted-foreground; wrap: word-wrap; }
                        
                        Rectangle { vertical-stretch: 1; }
                        HorizontalBox {
                            alignment: end;
                            spacing: 12px;
                            vertical-stretch: 0;
                            if !root.is-updating : Button { text: "Później"; clicked => { root.close-update-dialog(); } }
                            Button {
                                text: root.is-updating ? "Pobieranie..." : "Aktualizuj";
                                primary: true;
                                enabled: !root.is-updating;
                                clicked => { root.request-install-update(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
