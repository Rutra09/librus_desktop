import { Theme } from "style.slint";
import { ScrollView } from "std-widgets.slint";
import { Icon, Card, Badge, PageBody, PageHeader, EmptyState } from "kit.slint";
import { IconSet } from "@lucide";

export struct UIHomework {
    id: int,
    subject: string,
    content: string,
    date: string,
    category: string,
    author: string,
}

component HomeworkRow {
    in property <UIHomework> homework;
    in property <bool> last: false;

    VerticalLayout {
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            Text {
                text: root.homework.subject;
                font-size: Theme.text-body-lg;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }

            if root.homework.category != "" : Badge {
                label: root.homework.category;
                tone: Theme.text-3;
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.homework.date;
                font-size: Theme.text-caption;
                font-weight: 600;
                color: Theme.accent-text;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.homework.content;
            font-size: Theme.text-body;
            color: Theme.text-2;
            wrap: word-wrap;
        }

        if root.homework.author != "" : Text {
            text: "Dodał(a): " + root.homework.author;
            font-size: Theme.text-caption;
            color: Theme.text-4;
        }

        if !root.last : Rectangle {
            height: 1px;
            background: Theme.hairline-soft;
        }
    }
}

export component HomeworkView inherits Rectangle {
    in property <[UIHomework]> homework-list;
    callback back();

    background: Theme.bg-gradient;

    ScrollView {
        PageBody {
            PageHeader {
                title: "Zadania domowe";
                subtitle: root.homework-list.length == 1 ? "1 zadanie" : root.homework-list.length + " zadań";
            }

            if root.homework-list.length == 0 : Card {
                height: 200px;
                VerticalLayout {
                    alignment: center;
                    EmptyState {
                        icon: IconSet.CircleCheck;
                        title: "Nic nie jest zadane";
                        message: "Korzystaj z wolnego czasu.";
                    }
                }
            }

            if root.homework-list.length > 0 : Card {
                VerticalLayout {
                    padding: Theme.space-5;
                    spacing: Theme.space-4;

                    for hw[idx] in root.homework-list : HomeworkRow {
                        homework: hw;
                        last: idx == root.homework-list.length - 1;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }
    }
}
