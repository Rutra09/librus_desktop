import { ScrollView } from "std-widgets.slint";
import { Theme } from "style.slint";
import { Icon, Card, CardTitle, Divider, PageBody, PageHeader } from "kit.slint";
import { IconSet } from "@lucide";

export struct DashboardGrade {
    subject: string,
    grade: string,
    date: string,
    tone: color,
}

export struct DashboardHomework {
    subject: string,
    content: string,
    date: string,
}

export struct DashboardAnnouncement {
    title: string,
    date: string,
}

export struct DashboardLesson {
    time: string,
    subject: string,
}

// ── Small pieces ─────────────────────────────────────────────────────────────

component GradeChip inherits Rectangle {
    in property <string> value;
    in property <color> tone: Theme.accent;

    width: 26px;
    height: 26px;
    border-radius: Theme.radius-sm;
    background: root.tone.with-alpha(0.15);

    Text {
        text: root.value;
        font-size: Theme.text-small;
        font-weight: 600;
        color: root.tone;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Hint {
    in property <string> text;
    Text {
        text: root.text;
        font-size: Theme.text-small;
        color: Theme.text-4;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// ── Dashboard ────────────────────────────────────────────────────────────────

export component DashboardView inherits Rectangle {
    in property <string> user-name;
    in property <string> lucky-number;
    in property <string> lucky-number-day;
    in property <[DashboardGrade]> recent-grades;
    in property <[DashboardHomework]> upcoming-homework;
    in property <[DashboardAnnouncement]> recent-announcements;
    in property <[DashboardLesson]> next-day-timetable;
    in property <string> next-day-timetable-date;

    background: Theme.bg-gradient;

    ScrollView {
        PageBody {
            // ── Header ───────────────────────────────────────────────────────
            PageHeader {
                title: "Pulpit";
                subtitle: "Twój dzień w skrócie";
            }

            // ── Greeting + lucky number ──────────────────────────────────────
            HorizontalLayout {
                spacing: Theme.space-4;
                height: 112px;

                Card {
                    horizontal-stretch: 3;

                    HorizontalLayout {
                        padding: Theme.space-5;

                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;

                            Rectangle { vertical-stretch: 1; }

                            Text {
                                text: "Dzień dobry";
                                font-size: Theme.text-small;
                                color: Theme.text-3;
                            }
                            Text {
                                text: root.user-name;
                                font-size: Theme.text-large;
                                font-weight: 600;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Rectangle { height: Theme.space-2; }
                            Text {
                                text: "Miłego dnia w szkole.";
                                font-size: Theme.text-small;
                                color: Theme.text-3;
                            }

                            Rectangle { vertical-stretch: 1; }
                        }
                    }
                }

                Card {
                    horizontal-stretch: 1;
                    min-width: 190px;

                    VerticalLayout {
                        padding: Theme.space-5;
                        spacing: 0px;
                        // No `alignment` here: setting it makes the layout pack
                        // children at their preferred width instead of stretching
                        // them, which shoved the label to the card's right edge.
                        // The two stretching spacers below do the vertical centring.

                        Rectangle { vertical-stretch: 1; }

                        Text {
                            text: "Szczęśliwy numer";
                            font-size: Theme.text-caption;
                            font-weight: 600;
                            color: Theme.text-3;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.lucky-number;
                            font-size: Theme.text-display;
                            font-weight: 600;
                            color: Theme.accent-text;
                            letter-spacing: -1px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: root.lucky-number-day;
                            font-size: Theme.text-caption;
                            color: Theme.text-4;
                            horizontal-alignment: center;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // ── Grades + homework ────────────────────────────────────────────
            HorizontalLayout {
                spacing: Theme.space-4;

                Card {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: Theme.space-3;

                        CardTitle {
                            title: "Ostatnie oceny";
                            with-icon: true;
                            icon: IconSet.GraduationCap;
                        }
                        Divider {}

                        if root.recent-grades.length == 0 : Hint { text: "Brak ocen do wyświetlenia."; }

                        for g[idx] in root.recent-grades : VerticalLayout {
                            spacing: 0px;

                            HorizontalLayout {
                                spacing: Theme.space-3;
                                alignment: start;
                                height: 30px;

                                GradeChip {
                                    value: g.grade;
                                    tone: g.tone;
                                    y: 2px;
                                }
                                VerticalLayout {
                                    spacing: 0px;
                                    alignment: center;
                                    vertical-stretch: 1;
                                    Text {
                                        text: g.subject;
                                        font-size: Theme.text-body;
                                        font-weight: 500;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: g.date;
                                        font-size: Theme.text-caption;
                                        color: Theme.text-3;
                                    }
                                }
                            }
                            if idx < root.recent-grades.length - 1 : Rectangle {
                                height: 1px;
                                background: Theme.hairline-soft;
                            }
                        }
                    }
                }

                Card {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: Theme.space-3;

                        CardTitle {
                            title: "Nadchodzące zadania";
                            with-icon: true;
                            icon: IconSet.StickyNote;
                        }
                        Divider {}

                        if root.upcoming-homework.length == 0 : Hint { text: "Nic nie jest zadane. Korzystaj."; }

                        for hw[idx] in root.upcoming-homework : VerticalLayout {
                            spacing: 0px;

                            VerticalLayout {
                                spacing: 3px;
                                padding-bottom: Theme.space-2;
                                padding-top: 2px;

                                HorizontalLayout {
                                    spacing: Theme.space-2;
                                    alignment: start;

                                    Text {
                                        text: hw.subject;
                                        font-size: Theme.text-body;
                                        font-weight: 600;
                                        color: Theme.text;
                                        overflow: elide;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text {
                                        text: hw.date;
                                        font-size: Theme.text-caption;
                                        font-weight: 600;
                                        color: Theme.accent-text;
                                        vertical-alignment: center;
                                    }
                                }
                                Text {
                                    text: hw.content;
                                    font-size: Theme.text-small;
                                    color: Theme.text-2;
                                    wrap: word-wrap;
                                }
                            }
                            if idx < root.upcoming-homework.length - 1 : Rectangle {
                                height: 1px;
                                background: Theme.hairline-soft;
                            }
                        }
                    }
                }
            }

            // ── Timetable + announcements ────────────────────────────────────
            HorizontalLayout {
                spacing: Theme.space-4;

                Card {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: Theme.space-3;

                        CardTitle {
                            title: "Plan zajęć";
                            with-icon: true;
                            icon: IconSet.CalendarDays;
                            meta: root.next-day-timetable-date;
                        }
                        Divider {}

                        if root.next-day-timetable.length == 0 : Hint { text: "Brak lekcji — dzień wolny."; }

                        for l[idx] in root.next-day-timetable : VerticalLayout {
                            spacing: 0px;

                            HorizontalLayout {
                                spacing: Theme.space-3;
                                alignment: start;
                                height: 26px;

                                Text {
                                    text: l.time;
                                    font-size: Theme.text-caption;
                                    font-weight: 600;
                                    color: Theme.text-3;
                                    width: 46px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: l.subject;
                                    font-size: Theme.text-body;
                                    color: Theme.text;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            if idx < root.next-day-timetable.length - 1 : Rectangle {
                                height: 1px;
                                background: Theme.hairline-soft;
                            }
                        }
                    }
                }

                Card {
                    horizontal-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: Theme.space-3;

                        CardTitle {
                            title: "Ostatnie ogłoszenia";
                            with-icon: true;
                            icon: IconSet.Bell;
                        }
                        Divider {}

                        if root.recent-announcements.length == 0 : Hint { text: "Brak nowych ogłoszeń."; }

                        for a[idx] in root.recent-announcements : VerticalLayout {
                            spacing: 0px;

                            VerticalLayout {
                                spacing: 3px;
                                padding-bottom: Theme.space-2;
                                padding-top: 2px;

                                Text {
                                    text: a.title;
                                    font-size: Theme.text-body;
                                    font-weight: 500;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: a.date;
                                    font-size: Theme.text-caption;
                                    color: Theme.text-3;
                                }
                            }
                            if idx < root.recent-announcements.length - 1 : Rectangle {
                                height: 1px;
                                background: Theme.hairline-soft;
                            }
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }
    }
}
