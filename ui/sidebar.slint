import { Theme } from "style.slint";
import { Icon, Button, ButtonKind } from "kit.slint";
import { IconSet, Icon as LucideIcon } from "@lucide";

// ── NavItem ──────────────────────────────────────────────────────────────────

component NavItem inherits Rectangle {
    in property <LucideIcon> icon;
    in property <bool> active: false;
    in property <string> label;
    callback clicked;

    height: Theme.row-height;
    border-radius: Theme.radius;
    background: root.active ? Theme.accent-soft : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.motion-fast; easing: Theme.ease-standard; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        alignment: start;

        Icon {
            icon: root.icon;
            size: 16px;
            // The row is 32 px and the glyph is 16; the icon box fills the row so
            // the layout cannot pin it to the top edge above the label.
            height: root.height;
            tint: root.active ? Theme.accent-text : ta.has-hover ? Theme.text : Theme.text-3;
            weight: 1.75;
            animate tint { duration: Theme.motion-fast; easing: Theme.ease-standard; }
        }

        Text {
            text: root.label;
            font-size: Theme.text-body;
            font-weight: root.active ? 600 : 400;
            color: root.active ? Theme.accent-text : ta.has-hover ? Theme.text : Theme.text-2;
            vertical-alignment: center;
            animate color { duration: Theme.motion-fast; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Sidebar ──────────────────────────────────────────────────────────────────

export component Sidebar inherits Rectangle {
    in property <int> active-page;
    in property <string> user-name;
    in property <string> lucky-number;

    // Jakdojade properties
    in property <bool> jd-enabled: true;
    in property <string> jd-leave-time: "";
    in property <string> jd-arrival-info: "";
    in property <string> jd-lesson-day: "";
    in property <string> jd-route-lines: "";
    in property <string> jd-route-summary: "";
    in property <string> jd-status: "";

    callback navigate(int);
    callback logout();
    callback refresh();

    background: Theme.chrome-gradient;
    width: Theme.sidebar-width;
    height: 100%;

    // Glass edge on the content side — the only thing separating chrome from page
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.hairline-strong;
    }

    VerticalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        padding-top: Theme.space-4;
        padding-bottom: Theme.space-3;
        spacing: Theme.space-2;

        // ── Brand ────────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            height: 34px;
            padding-left: 4px;

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: Theme.radius;
                background: Theme.accent-soft;
                y: (parent.height - self.height) / 2;

                Icon {
                    icon: IconSet.BookOpen;
                    size: 15px;
                    tint: Theme.accent-text;
                    weight: 1.75;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            VerticalLayout {
                spacing: 0px;
                alignment: center;

                Text {
                    text: "Librus";
                    font-size: Theme.text-body-lg;
                    font-weight: 600;
                    color: Theme.text;
                }
                Text {
                    text: root.user-name;
                    font-size: Theme.text-caption;
                    color: Theme.text-3;
                    overflow: elide;
                }
            }
        }

        Rectangle { height: Theme.space-3; }

        // ── Navigation ───────────────────────────────────────────────────────
        NavItem {
            icon: IconSet.LayoutDashboard;
            label: "Pulpit";
            active: root.active-page == 1;
            clicked => { root.navigate(1); }
        }
        NavItem {
            icon: IconSet.CalendarDays;
            label: "Plan zajęć";
            active: root.active-page == 2;
            clicked => { root.navigate(2); }
        }
        NavItem {
            icon: IconSet.GraduationCap;
            label: "Oceny";
            active: root.active-page == 3;
            clicked => { root.navigate(3); }
        }
        NavItem {
            icon: IconSet.ClipboardList;
            label: "Frekwencja";
            active: root.active-page == 5;
            clicked => { root.navigate(5); }
        }
        NavItem {
            icon: IconSet.StickyNote;
            label: "Zadania domowe";
            active: root.active-page == 7;
            clicked => { root.navigate(7); }
        }
        NavItem {
            icon: IconSet.Bell;
            label: "Ogłoszenia";
            active: root.active-page == 4;
            clicked => { root.navigate(4); }
        }
        NavItem {
            icon: IconSet.Mail;
            label: "Wiadomości";
            active: root.active-page == 6;
            clicked => { root.navigate(6); }
        }
        NavItem {
            icon: IconSet.CalendarRange;
            label: "Terminarz";
            active: root.active-page == 8;
            clicked => { root.navigate(8); }
        }

        Rectangle { height: Theme.space-1; }
        Rectangle { height: 1px; background: Theme.hairline-soft; }
        Rectangle { height: Theme.space-1; }

        NavItem {
            icon: IconSet.Settings;
            label: "Ustawienia";
            active: root.active-page == 9;
            clicked => { root.navigate(9); }
        }

        Rectangle { vertical-stretch: 1; min-height: Theme.space-4; }

        // ── Commute ──────────────────────────────────────────────────────────
        if root.jd-enabled : Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.hairline-strong;

            VerticalLayout {
                padding: 12px;
                spacing: Theme.space-2;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    // `alignment: start` would ignore the spacer below and leave
                    // the day badge glued to the label instead of flush right.

                    Icon {
                        icon: IconSet.Bus;
                        size: 13px;
                        tint: Theme.accent-text;
                        weight: 1.75;
                        y: 1px;
                    }
                    Text {
                        text: "Dojazd";
                        font-size: Theme.text-caption;
                        font-weight: 600;
                        color: Theme.text-2;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.jd-lesson-day != "" : Rectangle {
                        height: 16px;
                        border-radius: Theme.radius-xs;
                        background: Theme.accent-soft;
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            alignment: center;
                            Text {
                                text: root.jd-lesson-day;
                                font-size: Theme.text-caption;
                                font-weight: 600;
                                color: Theme.accent-text;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                if root.jd-leave-time != "" : VerticalLayout {
                    spacing: 1px;
                    alignment: start;

                    Text {
                        text: "Wyjdź o";
                        font-size: Theme.text-caption;
                        color: Theme.text-3;
                    }
                    Text {
                        text: root.jd-leave-time;
                        font-size: Theme.text-large;
                        font-weight: 600;
                        color: Theme.success;
                        letter-spacing: -0.4px;
                    }
                    if root.jd-arrival-info != "" : Text {
                        text: root.jd-arrival-info;
                        font-size: Theme.text-caption;
                        color: Theme.text-2;
                        wrap: word-wrap;
                    }
                    if root.jd-route-lines != "" : Text {
                        text: root.jd-route-lines;
                        font-size: Theme.text-caption;
                        font-weight: 600;
                        color: Theme.accent-text;
                        wrap: word-wrap;
                    }
                }

                if root.jd-leave-time == "" : Text {
                    text: root.jd-status != "" ? root.jd-status : "Ładowanie połączenia…";
                    font-size: Theme.text-caption;
                    color: Theme.text-3;
                    wrap: word-wrap;
                }
            }
        }

        // ── Lucky number ─────────────────────────────────────────────────────
        if root.lucky-number != "" : Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.hairline-strong;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                height: 34px;
                // Same as the commute header: without a stretchable spacer the
                // number would sit right next to the label text.

                Text {
                    text: "Szczęśliwy numer";
                    font-size: Theme.text-caption;
                    color: Theme.text-3;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.lucky-number;
                    font-size: Theme.text-body-lg;
                    font-weight: 600;
                    color: Theme.accent-text;
                    vertical-alignment: center;
                }
            }
        }

        // ── Footer ───────────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: Theme.space-2;
            height: 32px;

            Button {
                label: "Odśwież";
                kind: ButtonKind.ghost;
                small: true;
                with-icon: true;
                icon: IconSet.RefreshCw;
                horizontal-stretch: 1;
                clicked => { root.refresh(); }
            }
            Button {
                label: "Wyloguj";
                kind: ButtonKind.ghost;
                small: true;
                with-icon: true;
                icon: IconSet.LogOut;
                horizontal-stretch: 1;
                clicked => { root.logout(); }
            }
        }
    }
}
