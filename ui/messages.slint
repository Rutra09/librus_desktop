import { ScrollView } from "std-widgets.slint";
import { Theme } from "style.slint";
import { Icon, Button, ButtonKind, TextField, Card, Divider, PageBody, PageHeader, EmptyState } from "kit.slint";
import { IconSet } from "@lucide";

export struct UIMessage {
    id: int,
    subject: string,
    sender: string,
    date: string,
    read: bool,
    has-attachments: bool,
}

// ── List row ────────────────────────────────────────────────────────────────

component MessageRow inherits Rectangle {
    in property <UIMessage> message;
    in property <bool> selected: false;
    callback clicked;

    height: 62px;
    border-radius: Theme.radius;
    background: root.selected
        ? Theme.accent-soft
        : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.motion-fast; easing: Theme.ease-standard; }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        alignment: start;

        Rectangle {
            width: 6px;
            height: 6px;
            border-radius: 3px;
            background: root.message.read ? transparent : Theme.accent;
            y: 8px;
        }

        VerticalLayout {
            spacing: 3px;
            vertical-stretch: 1;
            alignment: start;

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: Theme.space-2;
                alignment: start;

                Text {
                    text: root.message.subject;
                    font-size: Theme.text-body;
                    font-weight: root.message.read ? 500 : 700;
                    color: root.message.read ? Theme.text-2 : Theme.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.message.has-attachments : Icon {
                    icon: IconSet.Paperclip;
                    size: 13px;
                    tint: Theme.text-3;
                    weight: 1.75;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: root.message.sender;
                    font-size: Theme.text-caption;
                    color: Theme.text-3;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.message.date;
                    font-size: Theme.text-caption;
                    color: Theme.text-4;
                }
            }

            Rectangle { vertical-stretch: 1; }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── View ────────────────────────────────────────────────────────────────────

export component MessagesView inherits Rectangle {
    in property <[UIMessage]> messages: [];
    in property <bool> needs-credentials: false;
    in property <string> selected-message-body: "";
    in property <bool> showing-details: false;

    callback back();
    callback submit-credentials(string, string);
    callback request-message-details(int);
    callback close-details();

    property <string> username: "";
    property <string> password: "";
    property <int> selected-index: -1;
    property <bool> has-selection: root.selected-index >= 0 && root.selected-index < root.messages.length;
    property <string> sel-subject: root.has-selection ? root.messages[root.selected-index].subject : "";
    property <string> sel-meta: root.has-selection ? (root.messages[root.selected-index].sender + "  ·  " + root.messages[root.selected-index].date) : "";

    background: Theme.bg-gradient;

    // ── Credentials gate ─────────────────────────────────────────────────────
    if root.needs-credentials : VerticalLayout {
        alignment: center;
        padding: Theme.space-8;

        Card {
            width: 380px;

            VerticalLayout {
                padding: Theme.space-6;
                spacing: Theme.space-4;

                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: Theme.radius-lg;
                    background: Theme.accent-soft;
                    Icon {
                        icon: IconSet.Mail;
                        size: 18px;
                        tint: Theme.accent-text;
                        weight: 1.75;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: "Wiadomości";
                        font-size: Theme.text-title;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    Text {
                        text: "Podaj dane logowania Synergia, aby zobaczyć wiadomości.";
                        font-size: Theme.text-small;
                        color: Theme.text-3;
                        wrap: word-wrap;
                    }
                }

                TextField {
                    label: "Login Synergia";
                    placeholder: "np. 1234567u";
                    edited(v) => { root.username = v; }
                }
                TextField {
                    label: "Hasło";
                    placeholder: "••••••••";
                    password: true;
                    edited(v) => { root.password = v; }
                    accepted => {
                        if root.username != "" && root.password != "" {
                            root.submit-credentials(root.username, root.password);
                        }
                    }
                }

                Button {
                    label: "Zapisz i wczytaj";
                    kind: ButtonKind.primary;
                    large: true;
                    enabled: root.username != "" && root.password != "";
                    clicked => { root.submit-credentials(root.username, root.password); }
                }
            }
        }
    }

    // ── Two-pane ─────────────────────────────────────────────────────────────
    if !root.needs-credentials : VerticalLayout {
        PageBody {
            PageHeader {
                title: "Wiadomości";
                subtitle: root.messages.length == 1 ? "1 wiadomość" : root.messages.length + " wiadomości";
            }

            HorizontalLayout {
                spacing: Theme.space-4;
                min-height: 420px;

                // List
                Card {
                    width: 330px;
                    vertical-stretch: 1;

                    VerticalLayout {
                        padding: Theme.space-2;
                        spacing: 0px;

                        if root.messages.length == 0 : VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            EmptyState {
                                icon: IconSet.Inbox;
                                title: "Brak wiadomości";
                                message: "Nic nowego od nauczycieli.";
                            }
                        }

                        for msg[idx] in root.messages : MessageRow {
                            message: msg;
                            selected: root.selected-index == idx && root.showing-details;
                            clicked => {
                                root.selected-index = idx;
                                root.request-message-details(msg.id);
                            }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                // Detail
                Card {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    VerticalLayout {
                    if !root.showing-details || !root.has-selection : VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        EmptyState {
                            icon: IconSet.MailOpen;
                            title: "Wybierz wiadomość";
                            message: "Treść pojawi się tutaj.";
                        }
                    }

                    if root.showing-details && root.has-selection : VerticalLayout {
                        padding: Theme.space-5;
                        spacing: Theme.space-3;

                        HorizontalLayout {
                            spacing: Theme.space-2;
                            alignment: start;

                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.sel-subject;
                                    font-size: Theme.text-title;
                                    font-weight: 600;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: root.sel-meta;
                                    font-size: Theme.text-caption;
                                    color: Theme.text-3;
                                }
                            }

                            Button {
                                label: "Zamknij";
                                kind: ButtonKind.ghost;
                                small: true;
                                clicked => { root.close-details(); }
                            }
                        }

                        Divider {}

                        ScrollView {
                            vertical-stretch: 1;
                            Text {
                                text: root.selected-message-body;
                                font-size: Theme.text-body;
                                color: Theme.text-2;
                                wrap: word-wrap;
                            }
                        }
                    }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }
    }
}
