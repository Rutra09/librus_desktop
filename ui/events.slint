import { ScrollView } from "std-widgets.slint";
import { Theme } from "style.slint";
import { Icon, Card, Badge, PageBody, PageHeader, Segmented, EmptyState } from "kit.slint";
import { IconSet } from "@lucide";

export struct UIEvent {
    subject: string,
    content: string,
    category: string,
    date: string,
    lesson-no: string,
    teacher: string,
}

component EventRow {
    in property <UIEvent> item;
    in property <bool> last: false;

    VerticalLayout {
        spacing: Theme.space-2;

        HorizontalLayout {
            spacing: Theme.space-2;
            alignment: start;

            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: Theme.radius-sm;
                background: Theme.accent-soft;
                y: 1px;
                Icon {
                    icon: IconSet.CalendarRange;
                    size: 13px;
                    tint: Theme.accent-text;
                    weight: 1.75;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: Theme.space-2;
                    alignment: start;

                    Text {
                        text: root.item.subject;
                        font-size: Theme.text-body-lg;
                        font-weight: 600;
                        color: Theme.text;
                        vertical-alignment: center;
                    }
                    if root.item.category != "" : Badge {
                        label: root.item.category;
                        tone: Theme.accent-text;
                    }
                }

                Text {
                    text: root.item.date
                        + (root.item.lesson-no != "" ? "  ·  lekcja " + root.item.lesson-no : "")
                        + (root.item.teacher != "" ? "  ·  " + root.item.teacher : "");
                    font-size: Theme.text-caption;
                    color: Theme.text-3;
                }
            }
        }

        Text {
            text: root.item.content;
            font-size: Theme.text-body;
            color: Theme.text-2;
            wrap: word-wrap;
        }

        if !root.last : Rectangle {
            height: 1px;
            background: Theme.hairline-soft;
        }
    }
}

export component EventsView inherits Rectangle {
    in property <[UIEvent]> upcoming-events;
    in property <[UIEvent]> today-events;
    in property <[UIEvent]> past-events;

    property <int> active-tab: 0;
    property <[UIEvent]> current-events: root.active-tab == 0 ? root.upcoming-events : root.active-tab == 1 ? root.today-events : root.past-events;

    background: Theme.bg-gradient;

    ScrollView {
        PageBody {
            PageHeader {
                title: "Terminarz";
                subtitle: "Sprawdziany, wydarzenia i terminy";

                Segmented {
                    width: 300px;
                    items: ["Nadchodzące (" + root.upcoming-events.length + ")", "Dzisiaj (" + root.today-events.length + ")", "Minione (" + root.past-events.length + ")"];
                    current: root.active-tab;
                    changed(i) => { root.active-tab = i; }
                }
            }

            if root.current-events.length == 0 : Card {
                height: 200px;
                VerticalLayout {
                    alignment: center;
                    EmptyState {
                        icon: IconSet.CalendarRange;
                        title: "Nic tu nie ma";
                        message: "Brak wydarzeń w tej kategorii.";
                    }
                }
            }

            if root.current-events.length > 0 : Card {
                VerticalLayout {
                    padding: Theme.space-5;
                    spacing: Theme.space-4;

                    for ev[idx] in root.current-events : EventRow {
                        item: ev;
                        last: idx == root.current-events.length - 1;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }
    }
}
