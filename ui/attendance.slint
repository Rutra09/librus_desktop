import { ScrollView } from "std-widgets.slint";
import { Theme } from "style.slint";
import { Icon, Card, CardTitle, Divider, PageBody, PageHeader, Segmented, Meter, EmptyState } from "kit.slint";
import { IconSet } from "@lucide";

export struct UIAttendance {
    id: string,
    date: string,
    type_name: string,
    subject: string,
    lesson_no: int,
    color: color,
    symbol: string,
    topic: string,
}

export struct UIAttendanceSubject {
    id: int,
    name: string,
    presence_count: int,
    absence_unexcused_count: int,
    absence_excused_count: int,
    late_count: int,
    total_count: int,
    frequency: string,
}

// ── Entry row ───────────────────────────────────────────────────────────────

component AttendanceRow inherits Rectangle {
    in property <UIAttendance> attendance;

    height: 56px;
    border-radius: Theme.radius;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.motion-fast; }

    HorizontalLayout {
        padding-left: Theme.space-3;
        padding-right: Theme.space-3;
        spacing: Theme.space-3;
        alignment: start;

        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-xl;
            background: root.attendance.color.with-alpha(0.18);
            border-width: 1px;
            border-color: root.attendance.color.with-alpha(0.35);
            y: (parent.height - self.height) / 2;

            Text {
                text: root.attendance.symbol;
                color: root.attendance.color;
                font-size: Theme.text-caption;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            spacing: 1px;
            alignment: center;
            vertical-stretch: 1;

            Text {
                text: root.attendance.type_name;
                font-size: Theme.text-body;
                font-weight: 600;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: root.attendance.subject + (root.attendance.topic != "" ? "  ·  " + root.attendance.topic : "");
                font-size: Theme.text-caption;
                color: Theme.text-3;
                overflow: elide;
            }
        }

        VerticalLayout {
            spacing: 1px;
            alignment: center;
            Text {
                text: root.attendance.date;
                font-size: Theme.text-caption;
                color: Theme.text-3;
                horizontal-alignment: right;
            }
            Text {
                text: "lekcja " + root.attendance.lesson_no;
                font-size: Theme.text-caption;
                color: Theme.text-4;
                horizontal-alignment: right;
            }
        }
    }

    ta := TouchArea {}
}

// ── Stats table ─────────────────────────────────────────────────────────────

component StatHeader {
    in property <string> label;
    in property <bool> wide: false;

    width: root.wide ? 0px : 46px;
    horizontal-stretch: root.wide ? 1 : 0;

    Text {
        text: root.label;
        font-size: Theme.text-caption;
        font-weight: 600;
        color: Theme.text-4;
        horizontal-alignment: root.wide ? left : right;
        vertical-alignment: center;
        letter-spacing: 0.3px;
    }
}

component StatRow {
    in property <UIAttendanceSubject> subject;
    in property <bool> last: false;

    property <float> ratio: root.subject.total_count > 0
        ? root.subject.presence_count / root.subject.total_count
        : 0.0;
    property <color> tone: root.ratio >= 0.9 ? Theme.success
        : root.ratio >= 0.8 ? Theme.warning : Theme.danger;

    VerticalLayout {
        spacing: 0px;

        HorizontalLayout {
            padding-left: Theme.space-2;
            padding-right: Theme.space-2;
            spacing: Theme.space-2;
            height: 40px;
            alignment: start;

            Text {
                text: root.subject.name;
                font-size: Theme.text-body;
                color: Theme.text;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }

            // % + meter
            VerticalLayout {
                width: 96px;
                spacing: 3px;
                alignment: center;
                Text {
                    text: root.subject.frequency;
                    font-size: Theme.text-small;
                    font-weight: 600;
                    color: root.tone;
                    horizontal-alignment: right;
                }
                Meter {
                    value: root.ratio;
                    tone: root.tone;
                    thickness: 3px;
                }
            }

            Text {
                text: root.subject.presence_count;
                width: 40px;
                font-size: Theme.text-small;
                color: Theme.text-2;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                text: root.subject.absence_unexcused_count;
                width: 40px;
                font-size: Theme.text-small;
                color: root.subject.absence_unexcused_count > 0 ? Theme.danger : Theme.text-4;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                text: root.subject.absence_excused_count;
                width: 40px;
                font-size: Theme.text-small;
                color: Theme.text-2;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            Text {
                text: root.subject.late_count;
                width: 40px;
                font-size: Theme.text-small;
                color: root.subject.late_count > 0 ? Theme.warning : Theme.text-4;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        if !root.last : Rectangle {
            height: 1px;
            background: Theme.hairline-soft;
        }
    }
}

// ── View ────────────────────────────────────────────────────────────────────

export component AttendanceView inherits Rectangle {
    in property <[UIAttendance]> attendances;
    in property <[UIAttendanceSubject]> stats;
    in property <string> frequency_str;
    in property <string> semester_name: "Semestr 1";

    property <int> active-tab: 0;

    background: Theme.bg-gradient;

    ScrollView {
        PageBody {
            PageHeader {
                title: "Frekwencja";
                subtitle: "Obecności, spóźnienia i nieobecności";

                Segmented {
                    width: 200px;
                    items: ["Lista", "Statystyki"];
                    current: root.active-tab;
                    changed(i) => { root.active-tab = i; }
                }
            }

            // ── Summary ──────────────────────────────────────────────────────
            HorizontalLayout {
                spacing: Theme.space-4;
                height: 88px;

                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: 0px;
                        alignment: center;
                        Rectangle { vertical-stretch: 1; }
                        Text {
                            text: "Frekwencja ogółem";
                            font-size: Theme.text-caption;
                            font-weight: 600;
                            color: Theme.text-3;
                        }
                        Text {
                            text: root.frequency_str;
                            font-size: Theme.text-large;
                            font-weight: 600;
                            color: Theme.text;
                            letter-spacing: -0.5px;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: 0px;
                        alignment: center;
                        Rectangle { vertical-stretch: 1; }
                        Text {
                            text: "Przedmioty";
                            font-size: Theme.text-caption;
                            font-weight: 600;
                            color: Theme.text-3;
                        }
                        Text {
                            text: "" + root.stats.length;
                            font-size: Theme.text-large;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }

                Card {
                    horizontal-stretch: 1;
                    VerticalLayout {
                        padding: Theme.space-4;
                        spacing: 0px;
                        alignment: center;
                        Rectangle { vertical-stretch: 1; }
                        Text {
                            text: "Wpisy";
                            font-size: Theme.text-caption;
                            font-weight: 600;
                            color: Theme.text-3;
                        }
                        Text {
                            text: "" + root.attendances.length;
                            font-size: Theme.text-large;
                            font-weight: 600;
                            color: Theme.text;
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            // ── List ─────────────────────────────────────────────────────────
            if root.active-tab == 0 : Card {
                VerticalLayout {
                    padding: Theme.space-2;
                    spacing: 0px;

                    if root.attendances.length == 0 : VerticalLayout {
                        height: 180px;
                        alignment: center;
                        EmptyState {
                            icon: IconSet.ClipboardList;
                            title: "Brak wpisów";
                            message: "Frekwencja jest czysta.";
                        }
                    }

                    for att in root.attendances : AttendanceRow {
                        attendance: att;
                    }
                }
            }

            // ── Stats ────────────────────────────────────────────────────────
            if root.active-tab == 1 : Card {
                VerticalLayout {
                    padding: Theme.space-3;
                    spacing: Theme.space-1;

                    HorizontalLayout {
                        padding-left: Theme.space-2;
                        padding-right: Theme.space-2;
                        spacing: Theme.space-2;
                        height: 24px;

                        StatHeader { label: "Przedmiot"; wide: true; }
                        Rectangle { width: 96px; }
                        StatHeader { label: "Ob."; }
                        StatHeader { label: "Nb."; }
                        StatHeader { label: "Usp."; }
                        StatHeader { label: "Sp."; }
                    }

                    Divider {}

                    for subj[idx] in root.stats : StatRow {
                        subject: subj;
                        last: idx == root.stats.length - 1;
                    }
                }
            }

            Rectangle { vertical-stretch: 1; min-height: 0px; }
        }
    }
}
