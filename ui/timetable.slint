import { ScrollView } from "std-widgets.slint";
import { Theme } from "style.slint";
import { Icon, IconButton, Button, ButtonKind, Divider, PageBody, PageHeader, Modal } from "kit.slint";
import { IconSet } from "@lucide";

// ── Data model ──────────────────────────────────────────────────────────────

export struct UIGridCell {
    has-lesson: bool,
    subject: string,
    teacher: string,
    room: string,
    hour-from: string,
    hour-to: string,
    lesson-type: int,       // 0=normal, 1=cancelled, 2=change, 3=shifted_source, 4=shifted_target
    event-content: string,
    event-category: string,
    change-info: string,
}

export struct UIGridRow {
    no: int,
    hour-from: string,
    hour-to: string,
    cells: [UIGridCell],
}

export struct UILesson {
    id: int,
    no: int,
    subject: string,
    teacher: string,
    room: string,
    color: brush,
    is-substitution: bool,
    is-canceled: bool,
    hour-from: string,
    hour-to: string,
    event-content: string,
    event-category: string,
    substitution-desc: string,
}

export struct UIDay {
    date: string,
    name: string,
    lessons: [UILesson],
}

// ── Cell ────────────────────────────────────────────────────────────────────

component GridCell inherits Rectangle {
    in property <UIGridCell> cell;
    in property <bool> is-today: false;
    callback clicked;

    property <bool> cancelled: cell.lesson-type == 1 || cell.lesson-type == 3;
    property <bool> changed: cell.lesson-type == 2 || cell.lesson-type == 4;

    border-radius: Theme.radius;
    clip: true;
    // A layout will not shrink an item below its content's minimum width, and a
    // single-line subject name was pushing column one ~80 px wider than the rest.
    // The width is owned by the grid (col-width), so the content must not vote.
    min-width: 0px;
    background: !cell.has-lesson
        ? (is-today ? #ffffff08 : transparent)
        : root.cancelled
        ? Theme.danger.with-alpha(0.08)
        : root.changed
        ? Theme.warning.with-alpha(0.08)
        : ta.has-hover ? Theme.surface-hover : Theme.surface;

    animate background { duration: Theme.motion-fast; easing: Theme.ease-standard; }

    // Left rule marks the block without colouring the whole cell
    if cell.has-lesson : Rectangle {
        x: 0px;
        y: 10px;
        width: 2px;
        height: parent.height - 20px;
        border-radius: 1px;
        background: root.cancelled ? Theme.danger.with-alpha(0.7)
            : root.changed ? Theme.warning.with-alpha(0.7)
            : Theme.accent.with-alpha(0.55);
    }

    VerticalLayout {
        visible: cell.has-lesson;
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 2px;
        alignment: start;

        if root.cancelled : Text {
            text: cell.lesson-type == 1 ? "Odwołane" : "Przeniesione";
            font-size: Theme.text-caption;
            font-weight: 600;
            color: Theme.danger;
            letter-spacing: 0.3px;
        }
        if root.changed : Text {
            text: cell.lesson-type == 2 ? "Zastępstwo" : "Przeniesione";
            font-size: Theme.text-caption;
            font-weight: 600;
            color: Theme.warning;
            letter-spacing: 0.3px;
        }

        Text {
            text: cell.subject;
            font-weight: 600;
            font-size: Theme.text-small;
            color: root.cancelled ? Theme.text-3 : Theme.text;
            wrap: word-wrap;
            overflow: elide;
        }

        Text {
            text: cell.teacher;
            font-size: Theme.text-caption;
            color: Theme.text-3;
            overflow: elide;
        }

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 13px;

            if cell.room != "" && cell.room != "-" : Text {
                text: "s. " + cell.room;
                font-size: Theme.text-caption;
                font-weight: 500;
                color: Theme.text-3;
                vertical-alignment: center;
            }
            if cell.change-info != "" : Text {
                text: cell.change-info;
                font-size: Theme.text-caption;
                color: root.changed ? Theme.warning : Theme.danger;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Rectangle { horizontal-stretch: 1; }
            if cell.event-content != "" : Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.accent;
                y: (parent.height - self.height) / 2;
            }
        }
    }

    ta := TouchArea {
        enabled: cell.has-lesson;
        mouse-cursor: cell.has-lesson ? pointer : default;
        clicked => { root.clicked(); }
    }
}

component MetaRow {
    in property <string> label;
    in property <string> value;

    HorizontalLayout {
        spacing: Theme.space-3;
        alignment: start;

        Text {
            text: root.label;
            font-size: Theme.text-small;
            color: Theme.text-3;
            width: 84px;
        }
        Text {
            text: root.value;
            font-size: Theme.text-small;
            color: Theme.text;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// ── Lesson modal ────────────────────────────────────────────────────────────

component LessonModal inherits Rectangle {
    in property <bool> open: false;
    in property <UIGridCell> cell;
    callback dismiss;

    property <bool> cancelled: root.cell.lesson-type == 1 || root.cell.lesson-type == 3;
    property <bool> changed: root.cell.lesson-type == 2 || root.cell.lesson-type == 4;
    property <string> status-label: root.cancelled ? (root.cell.lesson-type == 1 ? "Lekcja odwołana" : "Lekcja przeniesiona") : (root.cell.lesson-type == 2 ? "Zastępstwo" : "Lekcja przeniesiona");

    Modal {
        open: root.open;
        panel-width: 340px;
        dismiss => { root.dismiss(); }

        VerticalLayout {
            spacing: Theme.space-2;

            if root.cancelled || root.changed : Rectangle {
                background: root.cancelled ? Theme.danger.with-alpha(0.12) : Theme.warning.with-alpha(0.12);
                border-radius: Theme.radius-sm;
                width: self.preferred-width;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    height: 22px;
                    spacing: 5px;
                    alignment: start;

                    Icon {
                        icon: root.cancelled ? IconSet.Ban : IconSet.ArrowRightLeft;
                        size: 12px;
                        tint: root.cancelled ? Theme.danger : Theme.warning;
                        weight: 1.75;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.status-label;
                        font-size: Theme.text-caption;
                        font-weight: 600;
                        color: root.cancelled ? Theme.danger : Theme.warning;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.cell.subject;
                font-size: Theme.text-title;
                font-weight: 600;
                color: Theme.text;
                wrap: word-wrap;
            }
        }

        Divider {}

        VerticalLayout {
            spacing: Theme.space-2;

            MetaRow { label: "Godzina"; value: root.cell.hour-from + " – " + root.cell.hour-to; }
            if root.cell.teacher != "" : MetaRow { label: "Nauczyciel"; value: root.cell.teacher; }
            if root.cell.room != "" : MetaRow { label: "Sala"; value: root.cell.room; }
            if root.cell.change-info != "" : MetaRow { label: "Zmiana"; value: root.cell.change-info; }
        }

        if root.cell.event-content != "" : Rectangle {
            background: Theme.accent.with-alpha(0.08);
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.accent.with-alpha(0.18);

            VerticalLayout {
                padding: Theme.space-3;
                spacing: 2px;
                Text {
                    text: root.cell.event-category != "" ? root.cell.event-category : "Wydarzenie";
                    font-size: Theme.text-caption;
                    font-weight: 600;
                    color: Theme.accent-text;
                }
                Text {
                    text: root.cell.event-content;
                    font-size: Theme.text-small;
                    color: Theme.text-2;
                    wrap: word-wrap;
                }
            }
        }

        Button {
            label: "Zamknij";
            kind: ButtonKind.secondary;
            clicked => { root.dismiss(); }
        }
    }
}

// ── View ────────────────────────────────────────────────────────────────────

export component TimetableView inherits Rectangle {
    in property <[UIGridRow]> grid-rows;
    in property <[string]> day-headers;
    in property <string> week-range: "Ładowanie…";
    in property <int> today-col-index: -1;
    callback prev-week();
    callback next-week();

    background: Theme.bg-gradient;

    property <bool> overlay-open: false;
    property <UIGridCell> selected-cell;

    // Fixed grid geometry. Every row used to distribute the width among its own
    // cells, so a column was as wide as its longest subject name and no two
    // rows lined up. One column width, computed once, for the whole grid.
    property <int> cols: root.day-headers.length;
    property <length> gutter-no: 24px;
    property <length> gutter-hours: 52px;
    property <length> grid-gap: 4px;
    property <length> col-width: root.cols > 0
        ? max(72px, (root.width - Theme.page-padding * 2 - root.scrollbar-allowance - root.gutter-no - root.gutter-hours - root.grid-gap * (root.cols + 1)) / root.cols)
        : 0px;
    // The grid lives inside a ScrollView whose viewport is narrower than the
    // page by the scrollbar, so the column maths has to leave room for it.
    property <length> scrollbar-allowance: 16px;

    ScrollView {
        PageBody {
            PageHeader {
                title: "Plan zajęć";
                subtitle: root.week-range;

                HorizontalLayout {
                    spacing: 2px;
                    alignment: end;

                    IconButton {
                        icon: IconSet.ChevronLeft;
                        clicked => { root.prev-week(); }
                    }
                    IconButton {
                        icon: IconSet.ChevronRight;
                        clicked => { root.next-week(); }
                    }
                }
            }

            // Header
            HorizontalLayout {
                spacing: root.grid-gap;
                height: 26px;

                Rectangle { width: root.gutter-no; }
                Rectangle { width: root.gutter-hours; }

                for day[idx] in root.day-headers : Rectangle {
                    width: root.col-width;
                    background: transparent;

                    Text {
                        text: day;
                        font-size: Theme.text-caption;
                        font-weight: idx == root.today-col-index ? 700 : 600;
                        color: idx == root.today-col-index ? Theme.accent-text : Theme.text-3;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    if idx == root.today-col-index : Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        x: 8px;
                        width: parent.width - 16px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }
                }
            }

            // Rows
            for row in root.grid-rows : HorizontalLayout {
                spacing: root.grid-gap;
                height: 66px;

                Rectangle {
                    width: root.gutter-no;
                    background: transparent;
                    Text {
                        text: row.no;
                        font-size: Theme.text-caption;
                        color: Theme.text-4;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: root.gutter-hours;
                    background: transparent;
                    VerticalLayout {
                        alignment: center;
                        spacing: 0px;
                        Text {
                            text: row.hour-from;
                            font-size: Theme.text-caption;
                            font-weight: 600;
                            color: Theme.text-2;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: row.hour-to;
                            font-size: Theme.text-caption;
                            color: Theme.text-4;
                            horizontal-alignment: center;
                        }
                    }
                }

                for cell[idx] in row.cells : GridCell {
                    cell: cell;
                    is-today: idx == root.today-col-index;
                    width: root.col-width;
                    clicked => {
                        root.selected-cell = cell;
                        root.overlay-open = true;
                    }
                }
            }
        }
    }

    LessonModal {
        open: root.overlay-open;
        cell: root.selected-cell;
        dismiss => { root.overlay-open = false; }
    }
}
